{}},{"x":11142.953088484526,"y":-4516.844269507728,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:PfKy8Uwah8Y-4A9piuYaB","type":"slide","props":{"w":1280,"h":720,"index":25,"notes":""},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b21zos","typeName":"shape"},{"x":4956.30151108764,"y":78.81502194070072,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:4BTQDl9q_tI2VvJNwQars","type":"text","props":{"color":"black","size":"l","w":1120,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Reframe - Environments"}]}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"aXhTE","typeName":"shape"},{"x":1742.3773286745372,"y":409.885669362773,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:D1YNItU0lKjRpxn54LMEI","type":"text","props":{"color":"black","size":"s","w":552.0101407391496,"font":"serif","textAlign":"start","autoSize":false,"scale":1.2948584043836044,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"“We envision futures of godlike technological advancement […] : terraforming planets and travelling at warp speed. But when it comes to our expression of human nature, very little changes. We may be fighting with laser cannons and ray-guns but we’re still fighting. The same cycles of violence and vengeance still drive us to oppress and destroy each other, ourselves, and the rest of life - only with faster cars and sexier weapons.”"}]}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b0vtzP","typeName":"shape"},{"x":6744.62846646322,"y":968.7320122745784,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:IL3eCa4w6bGbSKK4SiJH-","type":"image","props":{"w":290.57184964755515,"h":317.43461178945154,"assetId":"asset:-987652525","playing":true,"url":"","crop":null,"flipX":false,"flipY":fa