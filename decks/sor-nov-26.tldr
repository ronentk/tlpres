"b0ub3j","typeName":"shape"},{"x":9753.177886672975,"y":-1788.2349123387073,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:pan1C3CR57fPV2Xm48qLD","type":"text","props":{"color":"black","size":"s","w":424.4756766477548,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"“We have spent centuries building institutions for teaching knowledge, certifying expertise, ... We have paid much less systematic attention to teaching people to ride their own brains."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Now we are handing them motorcycles.”"}]}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b1mTZ6","typeName":"shape"},{"id":"asset:-1242830384","type":"image","typeName":"asset","props":{"name":"tldrawFile","src":"data:image/png;base64,","w":1665,"h":1080,"fileSize":215746,"mimeType":"image/png","isAnimated":false},"meta":{}},{"x":385.36708956157827,"y":1088.188987443052,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:FBB5Ia81UzZjKD_j72gln","type":"image","props":{"w":331.6477427320329,"h":468.97063620701533,"assetId":"asset:-1316753808","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"aU5Ez","typeName":"shape"},{"x":11772.619701276324,"y":-1803.7238823741245,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:9P8Lhd6Tyb7hrN1OJqjmx","type":"collapsible","parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b0cb9f","props":{"w":587.1139882338721,"h":166.04885833471383,"title":"...but they haven't panned out yet.","richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"“But nostalgia aside there is little determined effort to pursue the vision of transformative new tools for thought.”"}]}]},"open":true},"typeName":"shape"},{"x":9932.230021195599,"y":1503.7872060136297,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:gxbSt16ZbpTjjGBMDAEKG","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"m","fill":"none","color":"black","labelColor":"black","bend":102.13034858014856,"start":{"x":5.665787829064357,"y":-6.46696797655477},"end":{"x":283.41229403990184,"y":-18.42633377686529},"arrowheadStart":"arrow","arrowheadEnd":"none","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b1Ks8Y","typeName":"shape"},{"x":2609.7257586239707,"y":1990.7091464632622,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:R0V1Xh-_zxxlensBFEOIS","type":"text","props":{"color":"blue","size":"s","w":296.6142922908648,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"For wise societies we need many more people at these stages"}]}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b0KSHn","typeName":"shape"},{"x":13495.265764957321,"y":-925.3925041091532,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:S5iZE8x44MTWs1ASLWt-G","type":"collapsible","parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b10YYA","props":{"w":383.5161439753974,"h":355.4644400395,"title":"4th person perspective","richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"“The 4th person perspective [post-conventional stage] allows individuals to "},{"type":"text","marks":[{"type":"bold"}],"text":"focus on epistemology"},{"type":"text","text":", that is, to examine how they came to believe what they believe and feel and how one knows and proves things.” "}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"link","attrs":{"href":"https://www.sloww.co/ego-development-theory-cook-greuter/","target":"_blank","rel":"noopener noreferrer nofollow","class":null,"title":null}}],"text":"https://www.sloww.co/ego-development-theory-cook-greuter/"}]}]},"open":false},"typeName":"shape"},{"x":1680,"y":0,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:slide-2","type":"slide","props":{"w":1280,"h":720,"index":2,"notes":""},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"a4cWj","typeName":"shape"},{"meta":{},"id":"binding:l3OejKwvQzvGlJJZLPxeH","type":"arrow","fromId":"shape:rwkctIA7DSSY41iHTHQB6","toId":"shape:9iTZkB8FisiMNRD8WfvG1","props":{"isPrecise":true,"isExact":false,"normalizedAnchor":{"x":0.5743327701315482,"y":0.6287470938886167},"snap":"none","terminal":"end"},"typeName":"binding"},{"x":2285.6174825938942,"y":1295.1964904340155,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:qKStE-2Z1gr7iKC42V5w5","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"s","fill":"pattern","color":"light-blue","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":2,"y":0},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b08ZzsV","typeName":"shape"},{"meta":{},"id":"binding:xmn-JeyrciE0cpzY7EGZ8","type":"arrow","fromId":"shape:e1XtpCvB4ALyEFAFD9vpm","toId":"shape:q-7rdEt5EghvzD4My4OkB","props":{"isPrecise":true,"isExact":false,"normalizedAnchor":{"x":0.028283953113112,"y":0.37360263963465595},"snap":"none","terminal":"start"},"typeName":"binding"},{"x":9195.690751909304,"y":2464.835593308661,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:4saw9WkH0UrQwRU3b2buG","type":"geo","props":{"w":371.1125001472331,"h":207.95569236737052,"geo":"rectangle","dash":"dotted","growY":0,"url":"","scale":1,"flipX":false,"flipY":false,"color":"red","labelColor":"black","fill":"none","size":"l","font":"draw","align":"middle","verticalAlign":"middle","richText":{"type":"doc","content":[{"type":"paragraph"}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b0Tm2j","typeName":"shape"},{"x":3360,"y":0,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:slide-3","type":"slide","props":{"w":1280,"h":720,"index":3,"notes":""},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"a7edj","typeName":"shape"},{"x":13130.795375504005,"y":-4325.388656632677,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:_EuLQFIi3MDHyUuNJx5_t","type":"geo","props":{"w":248.9965362548828,"h":116.04737568385461,"geo":"rectangle","dash":"draw","growY":65.95262431614539,"url":"","scale":1,"flipX":false,"flipY":false,"color":"light-green","labelColor":"black","fill":"solid","size":"m","font":"draw","align":"middle","verticalAlign":"middle","richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Collections"},{"type":"text","text":" "}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Organize cards alone or with collaborators. Anyone can follow."}]}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b38KBX","typeName":"shape"},{"x":15450.76357853464,"y":-965.573868976059,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:68vxZQNLe5FM_HqQBebrc","type":"geo","props":{"w":665,"h":362.0000305175781,"geo":"rectangle","dash":"draw","growY":0,"url":"","scale":1,"flipX":false,"flipY":false,"color":"black","labelColor":"black","fill":"none","size":"m","font":"draw","align":"middle","verticalAlign":"middle","richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"A browser full of tabs is a rabbit hole in motion, but it disappears the second that window is closed, so are.na is where I actually catch the things worth keeping. I'll pull an image out of a rabbit-holed tab and drop it into a channel, and over enough time those channels start being their own little statements, connecting a block to three others I saved months apart is its own kind of visual modeling. "},{"type":"text","marks":[{"type":"bold"}],"text":"A form of mental bookmarking that quietly over time shows you the shape of your own attention or interests."}]}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b0nWVA","typeName":"shape"},{"x":11624.644105223633,"y":-2157.6480872914904,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:A8UTSxwpPlhfo0-XNhlVu","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"dotted","size":"s","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":2,"y":0},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b0bvzj8","typeName":"shape"},{"x":9747.081146812528,"y":-1932.2613617706884,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:6P8WkkAQjryjzeKuSJRA4","type":"text","props":{"color":"black","size":"s","w":503.58157298840524,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"“just as learning to ride a motorcycle is about extending a previously acquired ability to ride a bicycle, learning to ride AI is about extending a previously acquired ability to ride your own brain.”"}]}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b1kyA2","typeName":"shape"},{"meta":{},"id":"binding:SyuRVZrIY-LZK3x60ORek","type":"arrow","fromId":"shape:A8alooxWYNXsc2XyGHd_J","toId":"shape:u2pMON9LH1RTaRZgNbhH-","props":{"isPrecise":true,"isExact":false,"normalizedAnchor":{"x":0.08079224922276418,"y":0.894759343