false,"flipY":false,"color":"black","labelColor":"black","fill":"none","size":"s","font":"draw","align":"middle","verticalAlign":"middle","richText":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"📈"}]},{"type":"paragraph","content":[{"type":"text","text":"Growing"}]},{"type":"paragraph","content":[{"type":"text","text":"up"}]}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b0ETXM","typeName":"shape"},{"x":10388.902197419744,"y":-1901.5675497277923,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:_CSkWv8w6qELFLwfwpB16","type":"text","props":{"color":"black","size":"s","w":557.1192132329415,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"“Perhaps the most important educational challenge of the AI era is not teaching people to code, prompt, or even critically evaluate machine-generated information. Those are useful skills, but they are downstream of something more basic: learning to maintain dynamically stabilized control over your own cognitive activity, and then extending that control to a coupled system with a powerful generative machine.”"}]}]}},"parentId":"page:ivbEO23fPz6LIdb1Xi8t_","index":"b1l2jj","typeName":"shape"},{"x":11234.694591518524,"y":1702.2253858719591,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:1kbIlMh_Cka8Vz2jxQR3k","type":"text","props":{"color":"black","size":"s","w":492.42364501953125,"font":"draw","textAlign":"start","autoSize":true,"scale":0.6801369302178261,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"link","attrs":{"href":"https://x.com/nikitabier/status/1481118417973243907","target":"_blank","rel":"noopener noreferrer nofollow","class":null,"title":null}}],"text":"https://x.com/nikitabier/status/1481118417973243907"}]}]}},"p